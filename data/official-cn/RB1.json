/dtcg/Picture/1702876797307RB1-009_01.jpg"}]},"RB1-010":{"name":"天狼星兽","effect":"进化：<记述有“伽马兽”的Lv.5>起3\n\n【进化时】可从我方的手牌中，将1张记述有“伽马兽”的数码宝贝卡牌置于此数码宝贝的进化源最下方，并消灭对方1只DP不高于此数码宝贝DP的数码宝贝。\n\n【我方的回合】[每回合1次]当对方的数码宝贝被消灭时，可以将此数码宝贝转换为活跃状态。\n\n※此卡不属于名称中包含“星兽”的数码宝贝","inherited":"","security":"","image":"https://yugioh-1258002530.file.myqcloud.com/dtcg/Picture/1696923262955RB1-010.png","officialId":3237,"form":"究极体","attribute":"疫苗种","types":"光龙型","originalModel":"RB1-010","cnProductCode":"BTC-07","variants":[{"model":"RB1-010","productCode":"BTC-07","officialId":3237,"image":"https://yugioh-1258002530.file.myqcloud.com/dtcg/Picture/1696923262955RB1-010.png"},{"model":"RB1-010_01","productCode":"BTC-07","officialId":3238,"image":"https://yugioh-1258002530.file.myqcloud.com/dtcg/Picture/1696923262955RB1-010_01.png"},{"model":"RB1-010_02","productCode":"BTC-07","officialId":3239,"image":"https://yugioh-1258002530.file.myqcloud.com/dtcg/Picture/1696923262955RB1-010_02.png"}]},"RB1-011":{"name":"洁莉兽","effect":"【登场时】翻开我方卡组最上方的3张卡牌。将其中1张记述有“洁莉兽”的卡牌和1张“东御手洗清司郎”加入手牌。剩余的卡牌可自选顺序放回到卡组最下方。","inherited":"【我方的回合】[每回合1次]当我方的手牌因我方的效果被丢弃时，内存值+1。","security":"","image":"https://yugioh-1258002530.file.myqcloud.com/dtcg/Picture/1696923262955RB1-011.png","officialId":3240,"form":"成长期","attribute":"数据种","types":"软体型","originalModel":"RB1-011","cnProductCode":"BTC-07","variants":[{"model":"RB1-011","productCode":"BTC-07","officialId":3240,"image":"https://yugioh-1258002530.file.myqcloud.com/dtcg/Picture/1696923262955RB1-011.png"},{"model":"RB1-011_01","productCode":"BTC-07","officialId":3241,"image":"https://yugioh-1258002530.file.myqcloud.com/dtcg/Picture/1696923262956RB1-011_01.png"}]},"RB1-012":{"name":"卡乌斯伽马兽","effect":"进化：“伽马兽”起2\n\n《回避》（当此数码宝贝将要被消灭时，可将此数码宝贝转换为休息状态，并使其不会被消灭）","inherited":"","security":"","image":"https://yugioh-1258002530.file.myqcloud.com/dtcg/Picture/1696923262956RB1-012.png","officialId":3242,"form":"成熟期","attribute":"数据种","types":"龙人型","originalModel":"RB1-012","cnProductCode":"BT